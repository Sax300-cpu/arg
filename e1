<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Autores y Libros</title>
</head>
<body>

<h1>Gestión de Autores y Libros</h1>

<button onclick="mostrarTab('autores')">Autores</button>
<button onclick="mostrarTab('libros')">Libros</button>

<div id="seccionAutores">
    <h2>Autores</h2>
    <input type="text" id="txtBuscarAutor" placeholder="Nombre del autor...">
    <button onclick="buscarLibrosPorAutor()">Buscar libros</button>
    <button onclick="listarAutores()">Listar</button>
    <button onclick="abrirModalAgregarAutor()">Nuevo Autor</button>
    <div id="alertaAutores"></div>
    <table border="1" id="tablaAutores">
        <thead>
            <tr><th>ID</th><th>Nombre</th><th>Correo</th><th>Acciones</th></tr>
        </thead>
        <tbody></tbody>
    </table>
    <p id="sinAutores">No se encontraron autores.</p>
</div>

<div id="seccionLibros" style="display:none;">
    <h2>Libros</h2>
    <input type="text" id="txtBuscarLibro" placeholder="Título del libro...">
    <button onclick="buscarLibro()">Buscar</button>
    <button onclick="listarLibros()">Listar</button>
    <button onclick="abrirModalAgregarLibro()">Nuevo Libro</button>
    <div id="alertaLibros"></div>
    <table border="1" id="tablaLibros">
        <thead>
            <tr><th>ID</th><th>Título</th><th>Año</th><th>Autor</th><th>Acciones</th></tr>
        </thead>
        <tbody></tbody>
    </table>
    <p id="sinLibros">No se encontraron libros.</p>
</div>

<div id="modalAutor" style="display:none;">
    <h3 id="tituloModalAutor">Nuevo Autor</h3>
    <input type="hidden" id="txtModoAutor" value="agregar">
    <input type="hidden" id="txtIdAutor">
    <label>Nombre</label><br>
    <input type="text" id="txtNombreAutor"><br>
    <label>Correo</label><br>
    <input type="email" id="txtCorreoAutor"><br><br>
    <button onclick="guardarAutor()">Guardar</button>
    <button onclick="cerrarModal('modalAutor')">Cancelar</button>
</div>

<div id="modalLibro" style="display:none;">
    <h3 id="tituloModalLibro">Nuevo Libro</h3>
    <input type="hidden" id="txtModoLibro" value="agregar">
    <input type="hidden" id="txtIdLibro">
    <label>Título</label><br>
    <input type="text" id="txtTituloLibro"><br>
    <label>Año de publicación</label><br>
    <input type="number" id="txtAnioLibro" min="1000" max="2100"><br>
    <label>Autor</label><br>
    <select id="comboAutor">
        <option value="">Seleccione un autor</option>
    </select><br><br>
    <button onclick="guardarLibro()">Guardar</button>
    <button onclick="cerrarModal('modalLibro')">Cancelar</button>
</div>

<div id="modalLibrosAutor" style="display:none;">
    <h3 id="tituloLibrosAutor">Libros del Autor</h3>
    <table border="1">
        <thead>
            <tr><th>Título</th><th>Año</th></tr>
        </thead>
        <tbody id="cuerpoLibrosAutor"></tbody>
    </table>
    <p id="sinLibrosAutor">Este autor no tiene libros.</p>
    <button onclick="cerrarModal('modalLibrosAutor')">Cerrar</button>
</div>

<script>
    const ApiAutores = "http://127.0.0.1:8000/api/autores";
    const ApiLibros = "http://127.0.0.1:8000/api/libros";
    let autores = [];
    let libros = [];

    function mostrarAlerta(contenedor, tipo, mensaje) {
        document.getElementById(contenedor).innerHTML = '<p>' + tipo.toUpperCase() + ': ' + mensaje + '</p>';
        setTimeout(function () { document.getElementById(contenedor).innerHTML = ''; }, 3000);
    }

    function mostrarTab(tab) {
        document.getElementById('seccionAutores').style.display = tab === 'autores' ? 'block' : 'none';
        document.getElementById('seccionLibros').style.display = tab === 'libros' ? 'block' : 'none';
    }

    function cerrarModal(id) {
        document.getElementById(id).style.display = 'none';
    }

    function peticion(url, metodo, datos, callback) {
        var xhr = new XMLHttpRequest();
        xhr.open(metodo, url, true);
        xhr.setRequestHeader('Content-Type', 'application/json');
        xhr.onreadystatechange = function () {
            if (xhr.readyState === 4) {
                callback(xhr);
            }
        };
        xhr.send(datos ? JSON.stringify(datos) : null);
    }

    function listarAutores() {
        peticion(ApiAutores, 'GET', null, function (xhr) {
            if (xhr.status === 200) {
                autores = JSON.parse(xhr.responseText);
                renderTablaAutores(autores);
            } else {
                mostrarAlerta('alertaAutores', 'error', 'No se pudo cargar la lista de autores.');
            }
        });
    }

    function renderTablaAutores(lista) {
        var tbody = document.querySelector('#tablaAutores tbody');
        tbody.innerHTML = '';
        if (lista.length === 0) {
            document.getElementById('sinAutores').style.display = 'block';
            return;
        }
        document.getElementById('sinAutores').style.display = 'none';
        lista.forEach(function (autor) {
            tbody.innerHTML +=
                '<tr>' +
                '<td>' + autor.id + '</td>' +
                '<td>' + autor.nombre + '</td>' +
                '<td>' + autor.correo + '</td>' +
                '<td><button onclick="abrirModalEditarAutor(' + autor.id + ')">Editar</button></td>' +
                '</tr>';
        });
    }

    function abrirModalAgregarAutor() {
        document.getElementById('txtModoAutor').value = 'agregar';
        document.getElementById('tituloModalAutor').textContent = 'Nuevo Autor';
        document.getElementById('txtIdAutor').value = '';
        document.getElementById('txtNombreAutor').value = '';
        document.getElementById('txtCorreoAutor').value = '';
        document.getElementById('modalAutor').style.display = 'block';
    }

    function abrirModalEditarAutor(id) {
        var autor = autores.find(function (a) { return a.id === id; });
        if (!autor) return;
        document.getElementById('txtModoAutor').value = 'editar';
        document.getElementById('tituloModalAutor').textContent = 'Editar Autor';
        document.getElementById('txtIdAutor').value = autor.id;
        document.getElementById('txtNombreAutor').value = autor.nombre;
        document.getElementById('txtCorreoAutor').value = autor.correo;
        document.getElementById('modalAutor').style.display = 'block';
    }

    function guardarAutor() {
        var modo = document.getElementById('txtModoAutor').value;
        var nombre = document.getElementById('txtNombreAutor').value.trim();
        var correo = document.getElementById('txtCorreoAutor').value.trim();

        if (!nombre || !correo) {
            mostrarAlerta('alertaAutores', 'aviso', 'Todos los campos son obligatorios.');
            return;
        }

        var datos = { nombre: nombre, correo: correo };

        if (modo === 'agregar') {
            peticion(ApiAutores, 'POST', datos, function (xhr) {
                if (xhr.status === 201) {
                    cerrarModal('modalAutor');
                    mostrarAlerta('alertaAutores', 'exito', 'Autor agregado correctamente.');
                    listarAutores();
                } else {
                    mostrarAlerta('alertaAutores', 'error', 'No se pudo guardar el autor.');
                }
            });
        } else {
            var id = document.getElementById('txtIdAutor').value;
            peticion(ApiAutores + '/' + id, 'PUT', datos, function (xhr) {
                if (xhr.status === 200) {
                    cerrarModal('modalAutor');
                    mostrarAlerta('alertaAutores', 'exito', 'Autor actualizado correctamente.');
                    listarAutores();
                } else {
                    mostrarAlerta('alertaAutores', 'error', 'No se pudo actualizar el autor.');
                }
            });
        }
    }

    function buscarLibrosPorAutor() {
        var nombre = document.getElementById('txtBuscarAutor').value.trim();
        if (!nombre) {
            mostrarAlerta('alertaAutores', 'aviso', 'Ingrese el nombre de un autor.');
            return;
        }
        peticion(ApiAutores + '/' + encodeURIComponent(nombre), 'GET', null, function (xhr) {
            if (xhr.status === 200) {
                var data = JSON.parse(xhr.responseText);
                var tbody = document.getElementById('cuerpoLibrosAutor');
                tbody.innerHTML = '';
                if (data.libros && data.libros.length > 0) {
                    document.getElementById('sinLibrosAutor').style.display = 'none';
                    data.libros.forEach(function (libro) {
                        tbody.innerHTML +=
                            '<tr><td>' + libro.titulo + '</td><td>' + libro.anio_publicacion + '</td></tr>';
                    });
                } else {
                    document.getElementById('sinLibrosAutor').style.display = 'block';
                }
                document.getElementById('tituloLibrosAutor').textContent = 'Libros de ' + data.nombre;
                document.getElementById('modalLibrosAutor').style.display = 'block';
            } else {
                mostrarAlerta('alertaAutores', 'error', 'Autor no encontrado.');
            }
        });
    }

    function listarLibros() {
        peticion(ApiLibros, 'GET', null, function (xhr) {
            if (xhr.status === 200) {
                libros = JSON.parse(xhr.responseText);
                renderTablaLibros(libros);
            } else {
                mostrarAlerta('alertaLibros', 'error', 'No se pudo cargar la lista de libros.');
            }
        });
    }

    function renderTablaLibros(lista) {
        var tbody = document.querySelector('#tablaLibros tbody');
        tbody.innerHTML = '';
        if (lista.length === 0) {
            document.getElementById('sinLibros').style.display = 'block';
            return;
        }
        document.getElementById('sinLibros').style.display = 'none';
        lista.forEach(function (libro) {
            tbody.innerHTML +=
                '<tr>' +
                '<td>' + libro.id + '</td>' +
                '<td>' + libro.titulo + '</td>' +
                '<td>' + libro.anio_publicacion + '</td>' +
                '<td>' + (libro.autor ? libro.autor.nombre : 'N/A') + '</td>' +
                '<td><button onclick="abrirModalEditarLibro(' + libro.id + ')">Editar</button></td>' +
                '</tr>';
        });
    }

    function cargarComboAutores() {
        peticion(ApiAutores, 'GET', null, function (xhr) {
            if (xhr.status === 200) {
                var data = JSON.parse(xhr.responseText);
                var combo = document.getElementById('comboAutor');
                combo.innerHTML = '<option value="">Seleccione un autor</option>';
                data.forEach(function (autor) {
                    combo.innerHTML += '<option value="' + autor.id + '">' + autor.nombre + '</option>';
                });
            }
        });
    }

    function abrirModalAgregarLibro() {
        document.getElementById('txtModoLibro').value = 'agregar';
        document.getElementById('tituloModalLibro').textContent = 'Nuevo Libro';
        document.getElementById('txtIdLibro').value = '';
        document.getElementById('txtTituloLibro').value = '';
        document.getElementById('txtAnioLibro').value = '';
        cargarComboAutores();
        document.getElementById('modalLibro').style.display = 'block';
    }

    function abrirModalEditarLibro(id) {
        var libro = libros.find(function (l) { return l.id === id; });
        if (!libro) return;
        document.getElementById('txtModoLibro').value = 'editar';
        document.getElementById('tituloModalLibro').textContent = 'Editar Libro';
        document.getElementById('txtIdLibro').value = libro.id;
        document.getElementById('txtTituloLibro').value = libro.titulo;
        document.getElementById('txtAnioLibro').value = libro.anio_publicacion;
        cargarComboAutores();
        setTimeout(function () {
            document.getElementById('comboAutor').value = libro.autor_id;
        }, 300);
        document.getElementById('modalLibro').style.display = 'block';
    }

    function guardarLibro() {
        var modo = document.getElementById('txtModoLibro').value;
        var titulo = document.getElementById('txtTituloLibro').value.trim();
        var anio = document.getElementById('txtAnioLibro').value;
        var autor_id = document.getElementById('comboAutor').value;

        if (!titulo || !anio || !autor_id) {
            mostrarAlerta('alertaLibros', 'aviso', 'Todos los campos son obligatorios.');
            return;
        }

        var datos = { titulo: titulo, anio_publicacion: anio, autor_id: autor_id };

        if (modo === 'agregar') {
            peticion(ApiLibros, 'POST', datos, function (xhr) {
                if (xhr.status === 201) {
                    cerrarModal('modalLibro');
                    mostrarAlerta('alertaLibros', 'exito', 'Libro agregado correctamente.');
                    listarLibros();
                } else {
                    mostrarAlerta('alertaLibros', 'error', 'No se pudo guardar el libro.');
                }
            });
        } else {
            var id = document.getElementById('txtIdLibro').value;
            peticion(ApiLibros + '/' + id, 'PUT', datos, function (xhr) {
                if (xhr.status === 200) {
                    cerrarModal('modalLibro');
                    mostrarAlerta('alertaLibros', 'exito', 'Libro actualizado correctamente.');
                    listarLibros();
                } else {
                    mostrarAlerta('alertaLibros', 'error', 'No se pudo actualizar el libro.');
                }
            });
        }
    }

    function buscarLibro() {
        var titulo = document.getElementById('txtBuscarLibro').value.trim();
        if (!titulo) {
            mostrarAlerta('alertaLibros', 'aviso', 'Ingrese el título de un libro.');
            return;
        }
        peticion(ApiLibros + '/' + encodeURIComponent(titulo), 'GET', null, function (xhr) {
            if (xhr.status === 200) {
                renderTablaLibros([JSON.parse(xhr.responseText)]);
            } else {
                mostrarAlerta('alertaLibros', 'error', 'Libro no encontrado.');
            }
        });
    }

    window.onload = function () {
        listarAutores();
    };
</script>

