----------------app/Http/Controllers/Api/AutorController.php

<?php

namespace App\Http\Controllers\Api;

use App\Http\Controllers\Controller;
use App\Models\Autor;
use Illuminate\Http\Request;

class AutorController extends Controller
{
    public function index()
    {
        return Autor::all();
    }

    public function store(Request $request)
    {
        $request->validate([
            'nombre' => 'required',
            'correo' => 'required|email',
        ]);

        return Autor::create($request->only('nombre', 'correo'));
    }

    public function showByApellido($apellido)
    {
        $autor = Autor::where('nombre', 'LIKE', "%{$apellido}%")->first();

        if (!$autor) {
            return response()->json(['message' => 'Autor no encontrado'], 404);
        }

        return $autor->libros;
    }

    public function update(Request $request, $id)
    {
        $autor = Autor::findOrFail($id);

        $request->validate([
            'nombre' => 'required',
            'correo' => 'required|email',
        ]);

        $autor->update($request->only('nombre', 'correo'));

        return $autor;
    }

    public function destroy($id)
    {
        $autor = Autor::findOrFail($id);
        $autor->delete();

        return response()->json(['message' => 'Autor eliminado']);
    }
}

----------------app/Http/Controllers/Api/LibroController.php


<?php

namespace App\Http\Controllers\Api;

use App\Http\Controllers\Controller;
use App\Models\Libro;
use Illuminate\Http\Request;

class LibroController extends Controller
{
    public function index()
    {
        return Libro::all();
    }

    public function store(Request $request)
    {
        $request->validate([
            'titulo' => 'required',
            'anio_publicacion' => 'required|integer',
            'autor_id' => 'required|exists:autores,id',
        ]);

        return Libro::create($request->only('titulo', 'anio_publicacion', 'autor_id'));
    }

    public function showByTitulo($titulo)
    {
        $libro = Libro::where('titulo', 'LIKE', "%{$titulo}%")->first();

        if (!$libro) {
            return response()->json(['message' => 'Libro no encontrado'], 404);
        }

        return $libro;
    }

    public function update(Request $request, $id)
    {
        $libro = Libro::findOrFail($id);

        $request->validate([
            'titulo' => 'required',
            'anio_publicacion' => 'required|integer',
            'autor_id' => 'required|exists:autores,id',
        ]);

        $libro->update($request->only('titulo', 'anio_publicacion', 'autor_id'));

        return $libro;
    }

    public function destroy($id)
    {
        $libro = Libro::findOrFail($id);
        $libro->delete();

        return response()->json(['message' => 'Libro eliminado']);
    }
}

