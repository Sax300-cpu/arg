<script>
    var BASE = '/api';

    function cargarAutores() {
        var xhr = new XMLHttpRequest();
        xhr.open('GET', BASE + '/autores');
        xhr.onload = function() {
            if (xhr.status === 200) {
                var autores = JSON.parse(xhr.responseText);
                var selects = document.querySelectorAll('select');
                selects.forEach(function(sel) {
                    sel.innerHTML = '';
                    autores.forEach(function(a) {
                        var opt = document.createElement('option');
                        opt.value = a.id;
                        opt.text = a.nombre;
                        sel.appendChild(opt);
                    });
                });
            }
        };
        xhr.send();
    }

    function cargarLibros() {
        var xhr = new XMLHttpRequest();
        xhr.open('GET', BASE + '/libros');
        xhr.onload = function() {
            if (xhr.status === 200) {
                document.getElementById('lista_libros').textContent = JSON.stringify(JSON.parse(xhr.responseText), null, 2);
            }
        };
        xhr.send();
    }

    function crearAutor(e) {
        e.preventDefault();
        var datos = JSON.stringify({
            nombre: document.getElementById('autor_nombre').value,
            correo: document.getElementById('autor_correo').value
        });
        var xhr = new XMLHttpRequest();
        xhr.open('POST', BASE + '/autores');
        xhr.setRequestHeader('Content-Type', 'application/json');
        xhr.onload = function() {
            alert(xhr.status === 201 ? 'Autor creado' : 'Error: ' + xhr.responseText);
            cargarAutores();
        };
        xhr.send(datos);
    }

    function actualizarAutor(e) {
        e.preventDefault();
        var id = document.getElementById('autor_upd_id').value;
        var datos = JSON.stringify({
            nombre: document.getElementById('autor_upd_nombre').value,
            correo: document.getElementById('autor_upd_correo').value
        });
        var xhr = new XMLHttpRequest();
        xhr.open('PUT', BASE + '/autores/' + id);
        xhr.setRequestHeader('Content-Type', 'application/json');
        xhr.onload = function() {
            alert(xhr.status === 200 ? 'Autor actualizado' : 'Error: ' + xhr.responseText);
